# ==============================================================================
# SehatSetu Telemedicine & Healthcare Network Environment Configuration
# ==============================================================================

# 1. APPLICATION & ORIGIN
VITE_APP_NAME="SehatSetu"
VITE_APP_ORIGIN="https://uttamdasud.github.io/SehatSetu_Site/"
VITE_OWNER_UPI_ID="sehatsetu@upi"
VITE_OWNER_PAYEE_NAME="SehatSetu Medical Network"

# 2. CLOUD DATABASE (Supabase PostgreSQL)
# Run `database/schema.sql` in your Supabase SQL Editor, then paste keys here:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# 3. PAYMENT GATEWAY (Razorpay)
# Get key from https://dashboard.razorpay.com/app/keys
VITE_RAZORPAY_KEY_ID=""

# 4. MOBILE OTP SMS GATEWAY (Fast2SMS / MSG91 / Firebase)
# Fast2SMS quick dispatch (or Firebase Phone Auth):
VITE_SMS_GATEWAY_URL="https://www.fast2sms.com/dev/bulkV2"
VITE_SMS_API_KEY=""

# 5. WEBRTC VIDEO CALLING (Agora.io / LiveKit)
# Get App ID from https://console.agora.io/
VITE_AGORA_APP_ID=""

# 6. AUTOMATED WHATSAPP NOTIFICATIONS (Meta WhatsApp Business Cloud API)
# Get access token from https://developers.facebook.com/apps/
VITE_WHATSAPP_API_TOKEN=""
VITE_WHATSAPP_PHONE_NUMBER_ID=""

# 7. AYUSHMAN BHARAT DIGITAL MISSION (ABDM Sandbox)
VITE_ABHA_API_BASE="https://dev.abdm.gov.in/api/v1"
VITE_ABDM_CLIENT_ID=""
VITE_ABDM_CLIENT_SECRET=""
